# Copy to .env (never commit it) and fill in only what you need.
# Rendering the video needs none of these.

# LLM judges, Gemini ear/eye, image and video generation (tools/llm.py, judges.py, gemini_ear.py, gemini_eye.py,
# image_gen.py, video_gen.py) all go through OpenRouter.
OPENROUTER_API_KEY=

# ElevenLabs Music sketches and sound effects (tools/eleven_music.py, r2_sketches.py, sfx.py).
ELEVENLABS_API_KEY=

# gpt-4o-transcribe, one of the two transcribers in the vocal QA (tools/vocal_qa.py, song_qa.py).
OPENAI_API_KEY=

# Optional: path to a reference digest for the lyric judges (tools/judges.py; default refs/ledger_digest.md).
JUDGE_DIGEST=

# Optional: Chrome/Chromium for the headless renderer (video/kit/render.mjs and video/kit/tools/*.mjs).
# Default: the standard install location for your OS.
CHROME_PATH=

# Optional: scripts/figures/refusal.py input (default ../video-scratch/data/activations_2d.json next to this repo).
REFUSAL_ACTIVATIONS=

# Optional: where tools/fetch_take.sh looks for Suno downloads (default $HOME/Downloads).
DOWNLOADS=
